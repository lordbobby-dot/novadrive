# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# See docs/deployment.md for what each of these is and where to get it.

# --- Postgres (containerized here — see docker-compose.prod.yml's own comment on treating this
# as a managed-service recommendation, e.g. RDS, in a real deployment) ---
POSTGRES_USER=novadrive
POSTGRES_PASSWORD=
POSTGRES_DB=novadrive

# --- Public origins (used for CORS on the API side, and baked into the web build as the API's
# public URL) — must be the real, internet-reachable URLs of each app, not localhost ---
WEB_ORIGIN=https://app.example.com
API_ORIGIN=https://api.example.com

# --- Ports exposed on the host (change if 3000/4000 are already in use) ---
WEB_PORT=3000
API_PORT=4000

# --- Clerk — from your Clerk Dashboard, see docs/clerk-setup.md. Use LIVE keys (pk_live_.../
# sk_live_...) for a real production deployment, not the test keys used in local dev. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated emails granted admin on Clerk sync — see docs/admin.md. Leave unset if you'll
# promote the first admin directly in the database instead.
ADMIN_BOOTSTRAP_EMAILS=

# --- AWS S3 — real bucket, real credentials; there is no mock/local S3 in this project ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email — optional. Leave EMAIL_PROVIDER unset (or "console") to just log invitation emails
# instead of sending them, same as local dev. Set EMAIL_PROVIDER=resend for real delivery, and
# RESEND_API_KEY/EMAIL_FROM become required at boot (see docs/permissions.md) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=

# --- Observability — all optional; unset disables each integration entirely, see
# docs/observability.md ---
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- SEO — optional. NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION is the HTML-tag verification code from
# Google Search Console (Settings > Ownership verification); leave unset until you've started
# verification there. See docs/seo.md. ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
