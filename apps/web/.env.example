NEXT_PUBLIC_API_URL=http://localhost:4000

# From your Clerk Dashboard — see docs/clerk-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sentry error monitoring + Web Vitals — unset means disabled, see docs/observability.md
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# SEO — canonical public origin for metadata/sitemap/robots/OG images; falls back to the real
# production origin in src/lib/seo.ts if unset. Google Search Console verification code is
# optional — see docs/seo.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
