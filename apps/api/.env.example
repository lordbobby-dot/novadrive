NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://novadrive:novadrive@localhost:5432/novadrive?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# From your Clerk Dashboard — see docs/clerk-setup.md
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Comma-separated emails granted admin on Clerk sync — see docs/admin.md
ADMIN_BOOTSTRAP_EMAILS=

# Trash auto-purge and default quotas — see docs/quota.md. Defaults shown are what applies if unset.
TRASH_RETENTION_DAYS=30
DEFAULT_USER_QUOTA_BYTES=10737418240
DEFAULT_ORG_QUOTA_BYTES=107374182400

# AuditLog retention purge — see docs/security.md
AUDIT_LOG_RETENTION_DAYS=90

# Abandoned-upload cleanup — see docs/quota.md
ABANDONED_UPLOAD_STALE_HOURS=24

# Structured logging — see docs/observability.md
LOG_LEVEL=info

# OpenTelemetry tracing — unset OTEL_EXPORTER_OTLP_ENDPOINT disables tracing entirely
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=novadrive-api

# Sentry error monitoring — unset SENTRY_DSN disables Sentry entirely
SENTRY_DSN=
